# ── Base du control plane (ses propres tables cp_*, cp-schema.sql) ──
CP_SUPABASE_URL=
CP_SUPABASE_KEY=
CP_URL=https://app.vendd.fr   # le control-plane (vendd.fr = vitrine, repo separe)
TENANT_DOMAIN=vendd.fr        # suffixe des boutiques locataires (*.vendd.fr, wildcard Vercel)
CP_ADMIN_KEY=          # cle longue pour /flotte
CP_CRON_SECRET=        # protege /api/tick (appels a la main)
CRON_SECRET=           # meme role, envoye AUTOMATIQUEMENT par Vercel Cron
                       # (vercel.json declenche /api/tick chaque minute —
                       # cadence minute = plan Vercel Pro)

# ── Les jetons de l'usine (JAMAIS dans le depot) ────────────────────
SUPABASE_MGMT_TOKEN=   # sbp_... (Account -> Access Tokens)
SUPABASE_ORG_ID=       # Dashboard -> Organization settings
VERCEL_TOKEN=
VERCEL_TEAM_ID=        # vide si compte perso
MOTEUR_GITHUB_REPO=kieronvictoriahouse-blip/svenska-backend-

# ── Stripe Billing (abonnements Vendd — prix UNIQUE 39 EUR/mois HT) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=       # le prix mensuel Vendd (price_...)
# Offre live : prix UNIQUE 39 EUR/mois HT, essai 30 j (cf. vendd.fr).
# Creer dans Stripe (compte Valkode, acct_1UAxDdPveHTwScBC) un produit
# « Vendd » + un prix recurrent mensuel 39 EUR, puis coller son price_ ici.
# (Les anciens prix 3 paliers 79/129/179 en MODE TEST sont abandonnes.)

# ── Email de bienvenue (Resend) ─────────────────────────────────────
RESEND_API_KEY=        # re_... — sans elle, evenement bienvenue_a_envoyer
RESEND_FROM=           # ex. Vendd <bonjour@vendd.fr> (domaine verifie)
